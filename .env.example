# Application
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1

# Database
DATABASE_URL="postgresql://taskuser:taskpass@localhost:5432/taskdb?schema=public"

# JWT
JWT_ACCESS_SECRET=your-access-secret-change-me-in-production
JWT_REFRESH_SECRET=your-refresh-secret-change-me-in-production
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Security
BCRYPT_SALT_ROUNDS=12

# Rate limiting
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100
